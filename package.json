{
  "name": "contexthub",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
"scripts": {
  "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter \"./apps/*\" --filter \"./packages/*\" --if-present run typecheck",
  "lint": "eslint .",
  "format": "prettier --write .",
  "test": "vitest run --passWithNoTests",
  "dev:infra": "docker compose up -d",
  "dev:infra:down": "docker compose down"
},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}